# .env.example for PulseGuard demo
# Copy this to .env and adjust values as needed
# -------------------------------------------------
# General settings
EVENT_RATE=10            # events per second (baseline)
SINK=sqlite              # sqlite or eventhub
# SQLite settings
SQLITE_DB_PATH=./data/pulseguard.db
# EventHub settings (optional)
EVENTHUB_CONN_STR=YourEventHubConnectionString
EVENTHUB_NAME=YourEventHubName
# Alert webhook (optional, e.g., Teams/Slack)
WEBHOOK_URL=
# Freshness SLA (seconds)
FRESHNESS_SLA=60
# Adaptive rule parameters
ADAPTIVE_WINDOW_MIN=5
ADAPTIVE_K=2
# Cooldown for alerts (seconds)
ALERT_COOLDOWN=30
